# ExamBuddy Environment Variables
# Copy this file to .env.local and fill in the values

# Supabase (Postgres, Auth, Storage, Realtime)
# Found in your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Google Gemini API
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-1.5-flash

# Session Encryption Secret (at least 32 characters long)
SESSION_SECRET=exambuddy-karunya-super-secret-key-32-chars-min!

# Demo Admin Key (for resetting demo data during live presentation)
# Protected route: /api/demo/reset?key=your-key
DEMO_ADMIN_KEY=karunya-demo-admin-secure-key
